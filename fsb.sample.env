# Required Variables (DO NOT SKIP THESE)

API_ID=
API_HASH=
BOT_TOKEN=
LOG_CHANNEL=

# Optional Variables

# Log Level: debug, info, warn, error (default: info)
# Set to "error" to show only errors in console
LOG_LEVEL=info

# Media Channel ID for direct streaming via /direct/:message_id route
# This is the channel where your media files are stored
# Example: MEDIA_CHANNEL_ID=2625729812
# If not set, the /direct/:message_id route will return an error
MEDIA_CHANNEL_ID=

# Optional: local folder used to cache images from /thumb and /direct (photo)
# Default: ./images
# Example: IMAGE_DIR=./images
IMAGE_DIR=./images

# Firebase project used to validate ID tokens in /auth/firebase/exchange.
# If empty, /direct route will reject all requests.
# Required: Firebase project ID used by the application.
FIREBASE_PROJECT_ID=

# Optional: override Google cert endpoint used by Firebase token verification.
FIREBASE_CERTS_URL=https://www.googleapis.com/robot/v1/metadata/x509/securetoken@system.gserviceaccount.com

# Hasura endpoint used to confirm the Firebase user exists and is active before
# issuing a stream session. The same Firebase bearer token is used for the query.
HASURA_GRAPHQL_ENDPOINT=

# External Docker network used by docker-compose.yaml.
DOCKER_NETWORK_NAME=

# Short-lived stream session settings (used after Firebase exchange).
STREAM_SESSION_TTL_SECONDS=3600
STREAM_SESSION_CLEANUP_SECONDS=60
STREAM_SESSION_COOKIE_NAME=fsb_stream_session
STREAM_SESSION_COOKIE_SECURE=true
STREAM_SESSION_COOKIE_DOMAIN=

# Comma-separated hostnames allowed as browser (CORS) origins. A request Origin
# matches when its host equals a listed domain or is a subdomain of it.
# localhost / 127.0.0.1 are always allowed for dev.
# Example: CORS_ALLOWED_DOMAINS=example.com,cdn.example.com
CORS_ALLOWED_DOMAINS=

PORT=8080

# The length of the hash in your URLs
# https://domain.tld/1254?hash=asd45a
#                              ^^^^^^
#                                /
#                         This is the hash

HASH_LENGTH=6

# you can use IP address
# HOST=http://<ip address>:<PORT>
# Or you can also use a domain name
# HOST=https://example.com

# Worker startup timeout in seconds (useful when starting many worker bots in production)
WORKER_START_TIMEOUT_SECONDS=120

# Number of workers to race on direct stream metadata fetch (first successful wins)
# Default in code: 2
# Example: DIRECT_RACE_WORKERS=4
DIRECT_RACE_WORKERS=2

# For muti token support
# Refer https://github.com/EverythingSuckz/TG-FileStreamBot/tree/golang#use-multiple-bots-to-speed-up

# MULTI_TOKEN1=1857821156:AAEvrINCsduhjkjhahadvHRdk7oF46KZnc
# MULTI_TOKEN2=1355359001:AAF4dgddVVxDCt51FZqy1unh9h0SOTw0gU
# MULTI_TOKEN3=6941936497:AAGJzfoMHXshS8gVcsefUzpwyrbfU7gKRMM
# MULTI_TOKEN4=6546079247:AAF2k3uvO9Hqadfhjaskjds8jnzOAfQYUzTZ
